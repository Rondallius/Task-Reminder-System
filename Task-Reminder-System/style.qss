/* style.qss - the look of the program.

   main.py reads this file once and hands it to the QApplication, so the Python
   files stay free of colours.

   The theme is a clean light one: a light blue-grey window, white content
   areas, thin grey-blue borders, blue buttons and one blue rounded banner at
   the top. Flat colours only - no gradients, no animations, no dark mode. */

/* The palette used below, so every colour can be found in one place:
     window        #f4f7fb   light blue-grey
     content       #ffffff   white
     border        #d5deea   thin grey-blue line
     banner        #1769aa   the blue header
     button        #2563eb   hover #1d4ed8   pressed #1e40af
     text          #1f2937   labels #334155   dimmed #5b6b80
     selection     #dbeafe   light blue
     alternating   #f6f9fd   every second table row                       */

/* ------------------------------------------------------------------ root -- */
QWidget {
    background-color: #f4f7fb;
    color: #1f2937;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}

#mainContent {
    background-color: #f4f7fb;
}

/* ------------------------------------------- the blue banner at the top -- */
#appHeader {
    background-color: #1769aa;
    border: none;
    border-radius: 10px;
}

#appTitle {
    background: transparent;
    color: #ffffff;
    font-size: 19px;
    font-weight: 700;
}

#appSubtitle {
    background: transparent;
    color: #d6e6f7;
    font-size: 12px;
    font-weight: 400;
}

/* -------------------------------------------------------------- labels -- */
QLabel {
    background: transparent;
    color: #334155;
    font-weight: 600;
}

/* The line under the table that shows the running countdowns. */
#infoLabel {
    background-color: #ffffff;
    border: 1px solid #d5deea;
    border-radius: 6px;
    color: #3b4a5e;
    font-weight: 400;
    padding: 6px 10px;
}

/* ------------------------------------------------------------- buttons -- */
QPushButton {
    background-color: #2563eb;
    border: none;
    border-radius: 6px;
    color: #ffffff;
    font-weight: 600;
    min-height: 28px;
    padding: 7px 14px;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton:disabled {
    background-color: #a9bcda;
    color: #eff3f9;
}

/* ------------------------- the typed-in fields of the Add Task dialog -- */
QLineEdit,
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    color: #1f2937;
    padding: 6px 8px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

/* The border grows by one pixel and turns blue while a field is used, so it
   is always clear where the keyboard is. The padding shrinks by the same
   pixel, otherwise the box would jump when it gets the focus. */
QLineEdit:focus,
QTextEdit:focus {
    border: 2px solid #3b82f6;
    padding: 5px 7px;
}

/* --------------------------------------------------------------- table -- */
QTableWidget {
    outline: 0;                      /* no dashed box around the last cell */
    background-color: #ffffff;
    alternate-background-color: #f6f9fd;
    border: 1px solid #d5deea;
    border-radius: 6px;
    gridline-color: #e6ecf5;
    selection-background-color: #dbeafe;
    selection-color: #17457a;
}

/* The small inner margin is what gives the rows their comfortable height. */
QTableWidget::item {
    padding: 6px 8px;
}

/* The selected row must stay clearly marked, also while a button has the
   focus: Qt would otherwise paint a dull grey that looks like no selection.
   While the table itself has the focus the blue is stronger. */
QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #17457a;
}

QTableWidget::item:selected:active {
    background-color: #2f6fdb;
    color: #ffffff;
}

/* The row with ID, Task Name, Description, Reminder Time and Status. */
QHeaderView::section {
    background-color: #eaf2fb;
    border: none;
    border-bottom: 1px solid #d5deea;
    color: #334155;
    font-weight: 700;
    padding: 8px;
}

QTableCornerButton::section {
    background-color: #eaf2fb;
    border: none;
}

/* ----------------------------------------------------------- scrollbars -- */
QScrollBar:vertical {
    background-color: #f1f5fa;
    border: none;
    margin: 2px;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #9fb0c6;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7e93ae;
}

QScrollBar:horizontal {
    background-color: #f1f5fa;
    border: none;
    margin: 2px;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: #9fb0c6;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ----------------------------------------- dialog, message box, status -- */
QDialog,
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #1f2937;
    font-weight: 400;
}

QStatusBar {
    background-color: #eaf1f9;
    border-top: 1px solid #d5deea;
    color: #41526b;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    color: #1f2937;
}